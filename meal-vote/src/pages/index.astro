---
import BaseLayout from '@/components/layout/BaseLayout/index.astro';

// Components
import { MealVoteDashboard } from '@/components/MealVoteDashboard';

import '@/styles/globals.css';
---

<BaseLayout title="Kitchen · Meal vote">
  <header>
    <h1 class="text-3xl font-bold">Meal vote</h1>
    <p class="text-kitchen-muted">Pick a day to see how the team voted and which lunch won.</p>
  </header>
  <MealVoteDashboard client:load />
</BaseLayout>
